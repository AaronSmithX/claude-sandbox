{
  // Type checking only — no TypeScript files, and nothing emitted. The game stays
  // plain JavaScript; this reads the JSDoc that is already in it and holds the code
  // to it, which is a safety net the tests cannot provide (a typo in a field name is
  // not a failing test, it is undefined).
  //
  // Vite never runs this: esbuild strips types and does not check them. So `npm run
  // build` is exactly as fast as it was, and `npm run typecheck` is its own step.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // "node" is here for `vite.config.js` alone, which reads and writes score files
    // for the music editor's Save button. Nothing under `src/` may use it: that code
    // runs in a browser, where none of it exists.
    "types": ["vite/client", "node"],

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    "strict": true,
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.js", "*.js"]
}
